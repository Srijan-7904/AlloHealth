# Example environment variables for Allo Health Inventory System
# Copy this to .env.local and fill in your actual values

# REQUIRED: OpenAI API Key for GPT-4 AI Agent
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk_your_key_here

# Backend API URL (defaults to http://localhost:4000)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Razorpay Payment Gateway (optional, uses mock provider if not set)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
